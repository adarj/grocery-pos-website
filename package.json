{
  "name": "grocery-pos-website",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.0",
  "engines": {
    "node": ">=24.21.0 <25",
    "pnpm": "12.9.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "rescript": "rescript build",
    "lint": "eslint . --max-warnings=0",
    "format:check": "rescript format --check",
    "test:unit": "rescript build && node --test tests/unit/*.res.mjs",
    "typecheck": "rescript build && next typegen && tsc --noEmit",
    "build": "rescript build && next build",
    "start": "next start --hostname 127.0.0.1",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test accessibility.spec.ts --project=chromium"
  },
  "dependencies": {
    "@rescript/react": "0.15.0",
    "@rescript/runtime": "12.3.1",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "rescript": "12.3.1",
    "typescript": "6.0.3"
  }
}
